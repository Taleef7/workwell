+// WorkWell patch (#750): two DateTimes stated in different timezone offsets are compared in one offset.
+// `<` on two DateTime objects compares their toString(), which ends in the offset, so close times in
+// different offsets sorted out of instant order and `Last(... sort by ...)` could pick an older reading. The
+// second is converted to the first's offset with the library's own convertToTimezoneOffset, as
+// sameAs/before/after already do; DateTimes in one offset are compared exactly as before.
+function sortComparable(a, b) {
+    if (a != null && b != null && a.isDateTime && b.isDateTime && a.timezoneOffset != null && b.timezoneOffset != null && a.timezoneOffset !== b.timezoneOffset) {
+        return b.convertToTimezoneOffset(a.timezoneOffset);
+    }
+    return b;
+}

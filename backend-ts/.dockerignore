# Build-context exclusions for backend-ts/.
#
# NOTE: Docker only reads this file when the build *context* is backend-ts/ itself.
# Production builds use the REPO ROOT as context:
#   docker build -f backend-ts/Dockerfile -t <tag> .
# For those, BuildKit applies backend-ts/Dockerfile.dockerignore (patterns relative to
# the repo root). Keep both files in sync for the backend-ts tree. external/mieweb-cloud/
# is a sibling path outside this directory, so this file never filters it — that is
# intentional (workspace resolution needs the full submodule tree in the image).

node_modules
**/node_modules
.npm
.pnpm-store
.cache

# Tests / coverage (not needed at runtime; source under src/ is still required)
coverage
.nyc_output
**/*.test.ts
**/*.spec.ts
**/__tests__
**/__mocks__

# Local / editor / VCS noise
.git
.gitignore
.vscode
.idea
*.log
.env
.env.*
!.env.example

# Build artifacts (tsx runs TypeScript source directly; no compiled dist required)
dist
build
*.tsbuildinfo

# Do NOT exclude measures/official/ — the vendored official measure bundles (~10MB each, currently
# cms122 + cms125 = ~21MB) are loaded at runtime by wiring/official-artifacts.ts for the
# fqm-execution fidelity-diff path, and by the executor router once measures flip to official.
#
# SIZE WATCH: this grows ~10MB per measure and all 8 priority measures are planned (~80MB). The deploy
# job-poll window already had to be raised once when the image outgrew it (PR #283). Before vendoring
# the remaining six, enable `vendor:official --strip-elm-annotations`, which measures 79% smaller
# (9.8MB → 2.1MB of ELM for CMS122) — gated on the MADiE test-case suite proving it outcome-neutral,
# since ELM localIds are what fqm uses for clause coverage.
#
# Test-case decks are NOT here: they are fetched to .official-content/ and gitignored.

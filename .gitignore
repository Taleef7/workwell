# Downloaded official dQM bundles/test cases (fetched on demand; never vendored)
/backend-ts/.official-content/

# Official measure terminology, fetched at build (`pnpm vendor:official`) and pinned by the SHA-256 in
# each measure's committed manifest.json. NOT committed: these expansions carry thousands of AMA CPT
# and SNOMED CT codes, which this public repo has no licence to redistribute.
/backend-ts/measures/official/*/terminology.json

# Git worktrees (isolated workspaces — project-local)
.worktrees/

# Local-only notes (tokens, personal config — never commit)
docs/MCP_LOCAL.md
docs/vision doc screenshots
webchart-import/
# Local-only audit/planning working notes (owner preference: no audit clutter in the repo)
docs/ALIGNMENT_AUDIT_*.md

# Local-only call transcripts (personal/personnel content - never commit, never reference in docs).
# The directory AND the filename globs, because the globs below match on the BASENAME: a file named
# `docs/transcripts/2026-08-16 call.md` matches none of them and was committable by accident.
docs/transcripts/
# Any depth, any of the formats a recorder/transcriber emits.
**/*transcript*.txt
**/*transcript*.md
**/*transcript*.vtt
**/*transcript*.srt

# QRDA Schematron artifacts — third-party, ~585 KB, downloaded per reporting year for
# backend-ts/scripts/qrda-schematron-check.py (pinned by SHA-256 in the script, never vendored).
*.sch

# Cypress CVU+ research clone, Docker build context, and round notes (scratch only).
cvu-workdir/

# FHIR validator artifacts for backend-ts/scripts/deqm-validate.ts — a ~187 MB rolling "latest" jar
# and its generated reports/OperationOutcomes. Never vendored; the run records the jar's SHA-256.
validator_cli.jar
/backend-ts/.deqm-validate/
